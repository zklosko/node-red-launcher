{
  "name": "nodered-launcher",
  "productName": "Node-RED Launcher",
  "version": "0.1.0",
  "description": "A simple Windows launcher for installing, starting and restarting Node-RED",
  "main": "main.js",
  "type": "module",
  "author": {"name": "Zachary Klosko", "email": "zklosko@hopecentral.com", "url": "https://zklosko.github.io"},
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.zklosko.nodered-launcher",
    "productName": "Node-RED Launcher",
    "files": ["main.js", "preload.js", "renderer/**", "assets/**"],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
